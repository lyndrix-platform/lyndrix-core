{
  "colors": {
    "primary": {
      "light": "#0891b2",
      "dark": "#00d4ff"
    },
    "secondary": {
      "light": "#0284c7",
      "dark": "#0ea5e9"
    },
    "accent": {
      "light": "#7c3aed",
      "dark": "#8b5cf6"
    },
    "positive": {
      "light": "#0891b2",
      "dark": "#22d3ee"
    },
    "negative": {
      "light": "#ef4444",
      "dark": "#f87171"
    },
    "info": {
      "light": "#0ea5e9",
      "dark": "#00d4ff"
    },
    "warning": {
      "light": "#f59e0b",
      "dark": "#fbbf24"
    },
    "bg_body": {
      "light": "#f1f5f9",
      "dark": "#0a0e1a"
    },
    "bg_surface": {
      "light": "#ffffff",
      "dark": "#0f1629"
    },
    "bg_elevated": {
      "light": "#e2e8f0",
      "dark": "#162040"
    },
    "text_body": {
      "light": "#0f172a",
      "dark": "#f0f6ff"
    },
    "text_muted": {
      "light": "#64748b",
      "dark": "#94a3b8"
    },
    "text_subtle": {
      "light": "#94a3b8",
      "dark": "#94a3b8"
    },
    "surface_glass": {
      "light": "rgba(255, 255, 255, 0.72)",
      "dark": "rgba(15, 22, 41, 0.58)"
    },
    "elevated_glass": {
      "light": "rgba(255, 255, 255, 0.6)",
      "dark": "rgba(22, 32, 64, 0.55)"
    },
    "glass_border": {
      "light": "rgba(0, 0, 0, 0.12)",
      "dark": "rgba(255, 255, 255, 0.12)"
    },
    "border_accent": {
      "light": "rgba(8, 145, 178, 0.3)",
      "dark": "rgba(0, 212, 255, 0.2)"
    },
    "border_soft": {
      "light": "rgba(0, 0, 0, 0.09)",
      "dark": "rgba(255, 255, 255, 0.08)"
    }
  },
  "radius": {
    "sm": "0.125rem",
    "DEFAULT": "0.25rem",
    "md": "0.375rem",
    "lg": "0.5rem",
    "xl": "0.75rem",
    "2xl": "1rem",
    "3xl": "1.5rem",
    "full": "9999px"
  },
  "spacing": {
    "unit": "0.25rem"
  },
  "typography": {
    "font_sans": "'Lyndrix System Sans', 'JetBrainsMonoNL Nerd Font Propo', 'JetBrainsMono Nerd Font Propo', 'JetBrains Mono', 'Noto Sans', system-ui, -apple-system, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "font_mono": "'Lyndrix System Mono', 'JetBrainsMonoNL Nerd Font Mono', 'JetBrainsMono Nerd Font Mono', 'JetBrains Mono', 'Fira Code', 'Cascadia Code', Consolas, monospace",
    "text_scale": "1",
    "text_2xs": "calc(0.6875rem * var(--lx-text-scale))",
    "text_3xs": "calc(0.625rem * var(--lx-text-scale))"
  },
  "shadow": {
    "sm": "0 1px 2px 0 rgb(0 0 0 / 0.25)",
    "md": "0 8px 24px -12px rgb(0 0 0 / 0.45)",
    "lg": "0 30px 80px -20px rgb(0 0 0 / 0.6)",
    "glow": "0 0 30px rgb(0 212 255 / 0.3)"
  },
  "blur": {
    "xs": "10px",
    "sm": "8px",
    "md": "16px",
    "lg": "24px"
  },
  "transition": {
    "fast": "150ms",
    "base": "250ms",
    "slow": "400ms",
    "ease": "cubic-bezier(0.4, 0, 0.2, 1)"
  },
  "gradient": {
    "accent": "linear-gradient(135deg, var(--lx-accent), var(--lx-accent-2), var(--lx-accent-3))",
    "success": "linear-gradient(90deg, var(--lx-state-success), var(--lx-chart-8))",
    "warning": "linear-gradient(90deg, var(--lx-warning), var(--lx-chart-4))",
    "info": "linear-gradient(90deg, var(--lx-accent-2), var(--lx-accent))",
    "danger": "linear-gradient(90deg, var(--lx-state-down), var(--lx-chart-5))"
  },
  "border": {
    "width": "1px",
    "rail": "3px"
  },
  "icon": {
    "xs": "14px",
    "sm": "16px",
    "md": "18px",
    "lg": "32px"
  },
  "zindex": {
    "dropdown": "1000",
    "modal": "1100",
    "toast": "1200"
  },
  "effect": {
    "glass_saturate": "160%",
    "badge_bg_opacity": "0.15",
    "badge_border_opacity": "0.30"
  },
  "background_images": {
    "light": "background-light.webp",
    "dark": "background-dark.webp"
  }
}
